# Prevent direct access to PHP files in uploads directory
<Files "*.php">
    Order Deny,Allow
    Deny from all
</Files>

# Allow only image files
<FilesMatch "\.(jpg|jpeg|png|gif)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Deny access to other file types
<FilesMatch "\.(?!(jpg|jpeg|png|gif)$)[^.]+$">
    Order Deny,Allow
    Deny from all
</FilesMatch>